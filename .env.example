# Kopieren nach .env.local und ausfüllen. Niemals echte Werte committen.

# Öffentlich (landen im Browser-Bundle)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=4916200000000   # internationales Format ohne +

# Supabase (nur Server)
SUPABASE_URL=
SUPABASE_SCHEMA=leans
SUPABASE_SERVICE_ROLE_KEY=

# Stripe – zuerst ausschließlich Testmodus (sk_test_/pk_test_)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Zahlungsarten kommen aus dieser Konfiguration (Karte inkl. Apple/Google Pay, SEPA);
# Checkout akzeptiert kein payment_method_types mehr.
STRIPE_PAYMENT_METHOD_CONFIGURATION=
STRIPE_WEBHOOK_SECRET=

# Google Sheets (Service Account; Sheet für client_email als Bearbeiter freigeben)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Resend: Bestellbestätigung + "Unterwegs"-Mail an Kunden (mit Verfolgungslink), Hinweis an Lean.
# FROM braucht eine bei Resend verifizierte Domain, z. B. "Lean's Crispy Chicken <bestellung@deine-domain.de>".
# TO = Lean's Postfach für neue Bestellungen (auch Reply-To der Kundenmails).
RESEND_API_KEY=
ORDER_NOTIFICATION_FROM=
ORDER_NOTIFICATION_TO=

# Admin-Login (/admin): erlaubte E-Mail(s), kommagetrennt
ADMIN_EMAILS=
# scrypt:<salt>:<hash>, erzeugen mit: npm run admin:hash
ADMIN_PASSWORD_HASH=
# mind. 32 Zeichen Zufall
ADMIN_SESSION_SECRET=
